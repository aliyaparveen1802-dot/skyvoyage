# SkyVoyage server environment
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth (set a strong secret in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Optional integrations — the app runs fully without these.
# When unset, clearly-labelled mock adapters are used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

FLIGHT_SEARCH_PROVIDER=mock
FLIGHT_TRACKING_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Future live providers
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAPBOX_TOKEN=
EMAIL_PROVIDER_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
STRIPE_SECRET_KEY=
